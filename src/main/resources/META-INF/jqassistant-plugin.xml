<?xml version="1.0" encoding="UTF-8"?>
<jqassistant-plugin xmlns="http://schema.jqassistant.org/plugin/v2.4"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://schema.jqassistant.org/plugin/v2.4 https://jqassistant.github.io/jqassistant/current/schema/jqassistant-plugin-v2.4.xsd"
                    name="jQAssistant BC4J Plugin"
                    id="jqa.plugin.bc4j"
                    version="1.0.2">

    <description>
        Plugin de jQAssistant que escanea definiciones BC4J y registra Entities,
        ViewObjects, Associations, ViewLinks, ApplicationModules y metadatos de proyecto/configuracion
        como nodos y relaciones tipados. Conserva lineage de tablas y atributos para analizar solapamientos con JPA.
    </description>

    <model>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jEntityDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jEntityUsageDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jEntityAttributeDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jViewObjectDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jViewAttributeDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jXmlFileDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jViewLinkDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jViewLinkEndDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jApplicationModuleDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jViewUsageDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jEntityAssociationDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jAssociationEndDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jApplicationModuleConfigDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jProjectDescriptor</class>
        <class>org.jqassistant.plugin.bc4j.api.model.Bc4jPackageDescriptor</class>
    </model>

    <scanner>
        <class>org.jqassistant.plugin.bc4j.impl.scanner.Bc4jXmlScannerPlugin</class>
    </scanner>
    <rules>
        <resource>bc4j.xml</resource>
    </rules>

</jqassistant-plugin>
